{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start NOLIKTAVA server",
      "type": "shell",
      "command": "py",
      "args": ["-m", "http.server", "5500"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "Serving HTTP on"
        }
      }
    }
  ]
}
